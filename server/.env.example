# ── Required API Keys ────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Daily API key (only needed if using Daily transport)
DAILY_API_KEY=your_daily_api_key_here

# ── Optional Overrides ────────────────────────────────────────────────────────
# Change the ElevenLabs voice (default: Adam — pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Server Settings ───────────────────────────────────────────────────────────
# Bot server port (Pipecat runner default: 7860)
# PORT=7860

# Config API server port
CONFIG_SERVER_PORT=7861

# Config server host (0.0.0.0 for Docker/cloud, 127.0.0.1 for local-only)
CONFIG_SERVER_HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (use * to allow all)
ALLOWED_ORIGINS=*
