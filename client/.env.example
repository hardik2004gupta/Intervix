# ── Bot Server ────────────────────────────────────────────────
# URL of the Pipecat bot start endpoint (default: http://localhost:7860/start)
VITE_BOT_START_URL=http://localhost:7860/start

# Optional: bearer token for authenticated/production deployments
# VITE_BOT_START_PUBLIC_API_KEY=your_api_key_here

# ── Config Server ─────────────────────────────────────────────
# URL of the interview config API (default: http://localhost:7861)
VITE_CONFIG_SERVER_URL=http://localhost:7861
